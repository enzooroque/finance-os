# Copie este arquivo para .env.local e preencha. Passo a passo: docs/SUPABASE.md
# Nome exibido no app (opcional).
NEXT_PUBLIC_APP_NAME="Finance OS"

# Supabase > Project Settings > API Keys / Data API. Estas duas podem ir para o navegador
# (a proteção dos dados é o RLS no banco). A chave "anon" antiga também funciona.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NUNCA coloque a chave secret/service_role aqui nem com prefixo NEXT_PUBLIC_.
